# Copy this file to Config/local.env (ignored by git) and fill it in.
# Apple Developer Team ID: Xcode > Settings > Accounts > your account > Team (10 characters). A free Apple ID works too.
HUASIDELOAD_TEAM_ID=ABCDE12345
# Bundle ID of the iPhone app; watch apps send their messages to this ID
HUASIDELOAD_BUNDLE_ID=com.yourname.huasideload
